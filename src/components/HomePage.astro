---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import ProductCard from './ProductCard.astro';
import ProductTicker from './ProductTicker.astro';
import { ui } from '../i18n/ui';
import { loadProducts, formatPrice, coupangUrl, cutoutUrl } from '../lib/products';
import { CONTACT, mailHref, telHref } from '../lib/contact';
import type { Product } from '../lib/products';

const t = ui.ko;
const products = loadProducts();

// Category tiles double as the filter. Photo: a fixed representative part, else
// the category's first product (its cut-out when it has one).
const tilePhoto = (pn: string, list: Product[]) => {
  const p = list.find((x) => x.partNumber === pn) ?? list[0];
  if (!p) return undefined;
  const cutout = cutoutUrl(p);
  return { src: cutout ?? `/products/images/${p.image}`, cls: cutout ? 'product-cutout' : 'mix-blend-multiply' };
};
const inCat = (c: string) => products.filter((p) => p.category === c);
const categories = [
  { id: 'all', key: 'products.filterAll', list: products, photo: tilePhoto('L21099', products) },
  { id: 'oil', key: 'products.filterOil', list: inCat('oil'), photo: tilePhoto('L13005', inCat('oil')) },
  { id: 'oil-filter', key: 'products.filterOilFilter', list: inCat('oil-filter'), photo: tilePhoto('EK96006', inCat('oil-filter')) },
  { id: 'vacuum-filter', key: 'products.filterVacuumFilter', list: inCat('vacuum-filter'), photo: tilePhoto('18972', inCat('vacuum-filter')) },
] as const;

---

<BaseLayout>
  <Hero />
  <ProductTicker />

  <!-- Products Section -->
  <section id="products" class="section" aria-labelledby="products-title">
    <div class="container-custom">
      <div class="mb-8 md:mb-10">
        <h2 id="products-title" class="section-title" data-i18n="products.title">{t['products.title']}</h2>
        <p class="section-sub" data-i18n="products.subtitle">{t['products.subtitle']}</p>
      </div>

      {products.length > 0 ? (
        <>
          <!-- Category tiles = filter -->
          <div id="category-filters" class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
            {categories.map((c) => (
              <button
                type="button"
                data-filter={c.id}
                class:list={['filter-btn cat-tile', c.id === 'all' && 'filter-active']}
                aria-pressed={c.id === 'all' ? 'true' : 'false'}
              >
                <span class="relative z-10 text-[15px] md:text-lg font-extrabold tracking-[-0.02em]" data-i18n={c.key}>{t[c.key]}</span>
                <span class="cat-count">{c.list.length}</span>
                {c.photo && (
                  <span class="cat-disc" aria-hidden="true">
                    <img src={c.photo.src} class={c.photo.cls} alt="" loading="lazy" />
                  </span>
                )}
              </button>
            ))}
          </div>

          <!-- Search + Sort -->
          <div class="mt-5 flex flex-col sm:flex-row sm:items-center sm:justify-end gap-3">
            <div class="relative w-full sm:w-72">
              <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-ink-mute dark:text-snow-mute" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" />
              </svg>
              <input
                id="search-input"
                type="search"
                class="field w-full pl-11 pr-11"
                data-i18n-placeholder="products.searchPlaceholder"
                placeholder={t['products.searchPlaceholder']}
                aria-label={t['products.searchPlaceholder']}
                data-i18n-aria-label="products.searchPlaceholder"
              />
              <button id="search-clear" type="button" class="focus-ring absolute right-3 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full inline-flex items-center justify-center text-ink-mute hover:text-ink dark:text-snow-mute dark:hover:text-snow hidden" aria-label={t['a11y.clearSearch']} data-i18n-aria-label="a11y.clearSearch">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
            <select id="sort-select" class="field w-full sm:w-auto pr-10 cursor-pointer" aria-label={t['products.sortLabel']} data-i18n-aria-label="products.sortLabel">
              <option value="default" data-i18n-option="products.sortDefault">{t['products.sortDefault']}</option>
              <option value="price-asc" data-i18n-option="products.sortPriceAsc">{t['products.sortPriceAsc']}</option>
              <option value="price-desc" data-i18n-option="products.sortPriceDesc">{t['products.sortPriceDesc']}</option>
            </select>
          </div>

          <!-- Product Grid -->
          <div id="product-grid" class="mt-8 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-5">
            {products.map((product) => (
              <ProductCard
                partNumber={product.partNumber}
                nameKo={product.nameKo}
                nameEn={product.nameEn}
                image={`/products/images/${product.image}`}
                cutout={cutoutUrl(product)}
                descriptionKo={product.descriptionKo}
                descriptionEn={product.descriptionEn}
                category={product.category}
                price={formatPrice(product.price)}
                rawPrice={product.price}
                bestSeller={product.bestSeller}
                naverUrl={product.naverUrl}
                coupangUrl={coupangUrl(product)}
                coupangIsExact={Boolean(product.coupangUrl)}
              />
            ))}
          </div>

          <!-- Show More Button -->
          <div id="show-more-wrap" class="text-center mt-12">
            <button id="show-more-btn" type="button" class="btn-secondary gap-2">
              <span data-i18n="products.showMore">{t['products.showMore']}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>

          <!-- Empty filter state -->
          <div id="empty-filter" class="hidden text-center py-16">
            <svg class="w-12 h-12 mx-auto mb-4 text-ink-mute dark:text-snow-mute" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8M12 13v8" />
            </svg>
            <p class="text-lg text-ink-soft dark:text-snow-soft" data-i18n="products.comingSoon">{t['products.comingSoon']}</p>
          </div>
        </>
      ) : (
        <div class="text-center py-16">
          <svg class="w-12 h-12 mx-auto mb-4 text-ink-mute dark:text-snow-mute" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8M12 13v8" />
          </svg>
          <p class="text-lg text-ink-soft dark:text-snow-soft" data-i18n="products.comingSoon">{t['products.comingSoon']}</p>
        </div>
      )}
    </div>
  </section>

  <!-- Where to Buy Section -->
  <section id="buy" class="section pt-0" aria-labelledby="buy-title">
    <div class="container-custom">
      <div class="mb-8 md:mb-10">
        <h2 id="buy-title" class="section-title" data-i18n="buy.title">{t['buy.title']}</h2>
        <p class="section-sub" data-i18n="buy.subtitle">{t['buy.subtitle']}</p>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <a
          href="https://smartstore.naver.com/onevacuum"
          target="_blank"
          rel="noopener noreferrer"
          class="focus-ring group flex items-center gap-4 md:gap-5 rounded-3xl border border-line dark:border-night-line p-6 md:p-8 hover:border-ink dark:hover:border-snow transition-colors"
        >
          <span class="flex h-12 w-12 md:h-14 md:w-14 shrink-0 items-center justify-center rounded-2xl bg-paper dark:bg-night-high">
            <span class="w-2.5 h-2.5 rounded-full bg-naver" aria-hidden="true"></span>
          </span>
          <span class="text-xl md:text-2xl font-extrabold tracking-[-0.03em]" data-i18n="buy.naverStore">{t['buy.naverStore']}</span>
          <span class="ml-auto flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-paper dark:bg-night-high text-ink dark:text-snow transition-colors group-hover:bg-ink group-hover:text-white dark:group-hover:bg-snow dark:group-hover:text-ink" aria-hidden="true">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M7 17L17 7M8 7h9v9" /></svg>
          </span>
        </a>

        <a
          href="https://www.coupang.com/np/search?q=LEYBONOL"
          target="_blank"
          rel="noopener noreferrer"
          class="focus-ring group flex items-center gap-4 md:gap-5 rounded-3xl border border-line dark:border-night-line p-6 md:p-8 hover:border-ink dark:hover:border-snow transition-colors"
        >
          <span class="flex h-12 w-12 md:h-14 md:w-14 shrink-0 items-center justify-center rounded-2xl bg-paper dark:bg-night-high">
            <span class="w-2.5 h-2.5 rounded-full bg-coupang" aria-hidden="true"></span>
          </span>
          <span class="text-xl md:text-2xl font-extrabold tracking-[-0.03em]" data-i18n="buy.coupang">{t['buy.coupang']}</span>
          <span class="ml-auto flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-paper dark:bg-night-high text-ink dark:text-snow transition-colors group-hover:bg-ink group-hover:text-white dark:group-hover:bg-snow dark:group-hover:text-ink" aria-hidden="true">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M7 17L17 7M8 7h9v9" /></svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="section pt-0" aria-labelledby="contact-title">
    <div class="container-custom">
      <div class="rounded-[28px] md:rounded-[36px] bg-ink dark:bg-night-raised dark:ring-1 dark:ring-inset dark:ring-night-line text-white px-6 py-10 sm:px-10 md:px-14 md:py-14 grid lg:grid-cols-[1fr_2.2fr] gap-10">
        <h2 id="contact-title" class="text-[30px] md:text-[40px] font-extrabold leading-tight tracking-[-0.035em]" data-i18n="contact.title">{t['contact.title']}</h2>
        <dl class="grid sm:grid-cols-3 gap-8">
          <div>
            <dt class="text-sm text-white/60" data-i18n="contact.phone">{t['contact.phone']}</dt>
            <dd class="mt-2 text-xl md:text-2xl font-bold tracking-[-0.02em]">
              <a href={telHref(CONTACT.phone)} class="focus-ring rounded-sm hover:text-accent-light transition-colors" data-i18n="contact.phoneValue">{t['contact.phoneValue']}</a>
            </dd>
          </div>
          <div>
            <dt class="text-sm text-white/60" data-i18n="contact.email">{t['contact.email']}</dt>
            <dd class="mt-2 text-lg md:text-xl font-bold tracking-[-0.01em] break-all">
              <a href={mailHref(CONTACT.email)} class="focus-ring rounded-sm hover:text-accent-light transition-colors" data-i18n="contact.emailValue">{t['contact.emailValue']}</a>
            </dd>
          </div>
          <div>
            <dt class="text-sm text-white/60" data-i18n="contact.address">{t['contact.address']}</dt>
            <dd class="mt-2 text-[15px] leading-relaxed text-white/90" data-i18n="contact.addressValue">{t['contact.addressValue']}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { applyLang, type Lang } from '../i18n/client';

  // ===================== Search + Category Filter + Sort + Show More =====================
  const ITEMS_PER_PAGE = 8;
  const filters = document.getElementById('category-filters');
  const productGrid = document.getElementById('product-grid');
  const allCards = Array.from(document.querySelectorAll<HTMLElement>('.product-card'));
  const emptyFilter = document.getElementById('empty-filter');
  const showMoreWrap = document.getElementById('show-more-wrap');
  const showMoreBtn = document.getElementById('show-more-btn');
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const searchClear = document.getElementById('search-clear');

  let currentFilter = 'all';
  let currentSort = 'default';
  let currentSearch = '';
  let visibleLimit = ITEMS_PER_PAGE;

  function getSortedFilteredCards(): HTMLElement[] {
    let cards = allCards.filter((card) => {
      // Category filter
      if (currentFilter !== 'all' && card.dataset.category !== currentFilter) return false;

      // Search filter
      if (currentSearch) {
        const nameEl = card.querySelector('.product-name') as HTMLElement | null;
        const nameKo = (nameEl?.dataset.nameKo || '').toLowerCase();
        const nameEn = (nameEl?.dataset.nameEn || '').toLowerCase();
        const partNum = (card.dataset.partNumber || '').toLowerCase();
        if (!nameKo.includes(currentSearch) && !nameEn.includes(currentSearch) && !partNum.includes(currentSearch)) return false;
      }

      return true;
    });

    if (currentSort === 'price-asc') {
      cards.sort((a, b) => Number(a.dataset.price) - Number(b.dataset.price));
    } else if (currentSort === 'price-desc') {
      cards.sort((a, b) => Number(b.dataset.price) - Number(a.dataset.price));
    } else {
      // default: best sellers first, then by original order
      cards.sort((a, b) => {
        const aBest = a.dataset.bestSeller === '1' ? 0 : 1;
        const bBest = b.dataset.bestSeller === '1' ? 0 : 1;
        if (aBest !== bBest) return aBest - bBest;
        return allCards.indexOf(a) - allCards.indexOf(b);
      });
    }

    return cards;
  }

  function applyVisibility() {
    const sorted = getSortedFilteredCards();

    // Reorder DOM elements
    if (productGrid) {
      sorted.forEach((card) => productGrid.appendChild(card));
    }

    allCards.forEach((card) => (card.style.display = 'none'));
    sorted.forEach((card, i) => {
      card.style.display = i < visibleLimit ? '' : 'none';
    });

    if (productGrid && emptyFilter) {
      productGrid.style.display = sorted.length > 0 ? '' : 'none';
      emptyFilter.classList.toggle('hidden', sorted.length > 0);
    }

    if (showMoreWrap) {
      showMoreWrap.style.display = sorted.length > visibleLimit ? '' : 'none';
    }
  }

  applyVisibility();

  filters?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.filter-btn') as HTMLButtonElement | null;
    if (!btn) return;

    currentFilter = btn.dataset.filter || 'all';
    visibleLimit = ITEMS_PER_PAGE;

    filters.querySelectorAll('.filter-btn').forEach((b) => {
      b.classList.remove('filter-active');
      b.setAttribute('aria-pressed', 'false');
    });
    btn.classList.add('filter-active');
    btn.setAttribute('aria-pressed', 'true');

    applyVisibility();
  });

  sortSelect?.addEventListener('change', () => {
    currentSort = sortSelect.value;
    visibleLimit = ITEMS_PER_PAGE;
    applyVisibility();
  });

  showMoreBtn?.addEventListener('click', () => {
    visibleLimit += ITEMS_PER_PAGE;
    applyVisibility();
  });

  searchInput?.addEventListener('input', () => {
    currentSearch = (searchInput.value || '').trim().toLowerCase();
    visibleLimit = ITEMS_PER_PAGE;
    if (searchClear) {
      searchClear.classList.toggle('hidden', !currentSearch);
    }
    applyVisibility();
  });

  searchClear?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    currentSearch = '';
    searchClear.classList.add('hidden');
    visibleLimit = ITEMS_PER_PAGE;
    applyVisibility();
  });

  // Hero catalogue counts: select that category, then the link scrolls to the grid.
  document.querySelectorAll<HTMLAnchorElement>('[data-filter-link]').forEach((link) => {
    link.addEventListener('click', () => {
      filters?.querySelector<HTMLButtonElement>(`.filter-btn[data-filter="${link.dataset.filterLink}"]`)?.click();
    });
  });

  // ===================== Language Toggle =====================
  const btnKO = document.getElementById('btnKO')!;
  const btnEN = document.getElementById('btnEN')!;
  // The only key whose value contains markup (a constant string from ui.ts).
  const HTML_KEYS = new Set<string>(['hero.headline']);

  function setLang(lang: Lang) {
    btnKO.classList.toggle('lang-active', lang === 'ko');
    btnEN.classList.toggle('lang-active', lang === 'en');
    btnKO.setAttribute('aria-pressed', String(lang === 'ko'));
    btnEN.setAttribute('aria-pressed', String(lang === 'en'));
    applyLang(lang, { htmlKeys: HTML_KEYS });
  }

  btnKO.addEventListener('click', () => setLang('ko'));
  btnEN.addEventListener('click', () => setLang('en'));
</script>
