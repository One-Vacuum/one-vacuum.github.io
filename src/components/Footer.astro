---
import Logo from './Logo.astro';
import { ui } from '../i18n/ui';
import { CONTACT, mailHref, telHref } from '../lib/contact';

const t = ui.ko;
---

<footer class="border-t border-line dark:border-night-line">
  <div class="container-custom pt-14 pb-12 md:pt-16">
    <div class="flex flex-col md:flex-row md:justify-between gap-10">
      <!-- Company Info -->
      <div>
        <a href="/" class="focus-ring inline-flex rounded-sm text-ink dark:text-snow">
          <Logo class="h-[18px] md:h-[22px] w-auto" />
        </a>
        <p class="mt-4 text-sm text-ink-soft dark:text-snow-soft" data-i18n="site.description">
          {t['site.description']}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-[auto_minmax(0,22rem)] gap-10 sm:gap-16 text-sm">
        <!-- Quick Links -->
        <div>
          <h2 class="text-sm font-extrabold text-ink dark:text-snow">
            <a href="#" class="focus-ring rounded-sm hover:text-accent dark:hover:text-accent-light transition-colors" data-i18n="nav.home">{t['nav.home']}</a>
          </h2>
          <ul class="mt-4 space-y-2.5 text-ink-soft dark:text-snow-soft">
            <li><a href="#products" class="focus-ring rounded-sm hover:text-ink dark:hover:text-snow transition-colors" data-i18n="nav.products">{t['nav.products']}</a></li>
            <li><a href="#buy" class="focus-ring rounded-sm hover:text-ink dark:hover:text-snow transition-colors" data-i18n="nav.buy">{t['nav.buy']}</a></li>
            <li><a href="#contact" class="focus-ring rounded-sm hover:text-ink dark:hover:text-snow transition-colors" data-i18n="nav.contact">{t['nav.contact']}</a></li>
          </ul>
        </div>

        <!-- Contact -->
        <div>
          <h2 class="text-sm font-extrabold text-ink dark:text-snow" data-i18n="contact.title">{t['contact.title']}</h2>
          <ul class="mt-4 space-y-2.5 text-ink-soft dark:text-snow-soft">
            <li><a href={telHref(CONTACT.phone)} class="focus-ring rounded-sm hover:text-ink dark:hover:text-snow transition-colors" data-i18n="contact.phoneValue">{t['contact.phoneValue']}</a></li>
            <li><a href={mailHref(CONTACT.email)} class="focus-ring rounded-sm hover:text-ink dark:hover:text-snow transition-colors" data-i18n="contact.emailValue">{t['contact.emailValue']}</a></li>
            <li class="leading-relaxed" data-i18n="contact.addressValue">{t['contact.addressValue']}</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-line dark:border-night-line text-xs leading-relaxed text-ink-mute dark:text-snow-mute">
      <p>
        <span data-i18n="footer.company">{t['footer.company']}</span>
        <span class="mx-1.5 hidden sm:inline" aria-hidden="true">·</span>
        <br class="sm:hidden" />
        <span data-i18n="footer.owner">{t['footer.owner']}</span>
        <span class="mx-1.5 hidden sm:inline" aria-hidden="true">·</span>
        <br class="sm:hidden" />
        <span data-i18n="footer.bizNo">{t['footer.bizNo']}</span>
      </p>
      <p class="mt-1">
        <span data-i18n="contact.addressValue">{t['contact.addressValue']}</span>
        <span class="mx-1.5 hidden sm:inline" aria-hidden="true">·</span>
        <br class="sm:hidden" />
        <span data-i18n="contact.phoneValue">{t['contact.phoneValue']}</span>
        <span class="mx-1.5 hidden sm:inline" aria-hidden="true">·</span>
        <br class="sm:hidden" />
        <span data-i18n="contact.emailValue">{t['contact.emailValue']}</span>
      </p>
      <p class="mt-3" lang="en" data-i18n="footer.copyright">{t['footer.copyright']}</p>
    </div>
  </div>
</footer>
