---
import { ui } from '../i18n/ui';
import { loadProducts, formatPrice } from '../lib/products';

const t = ui.ko;
const products = loadProducts();
const byPart = (pn: string) => products.find((p) => p.partNumber === pn);

// Three containers of the same oil line, largest at the back. Any part number
// missing from products.json is simply skipped.
const stage = [
  { product: byPart('L13020'), cls: 'right-0 bottom-0 h-[88%] w-[58%]' },
  { product: byPart('L13005'), cls: 'left-[4%] bottom-0 h-[66%] w-[42%]' },
  { product: byPart('L70201'), cls: 'left-[34%] bottom-0 h-[47%] w-[28%]' },
].filter((s) => s.product);
const featured = stage[0]?.product;
---

<section class="container-custom pt-4 md:pt-6">
  <div class="rounded-[28px] md:rounded-[36px] bg-paper dark:bg-night-raised px-6 py-10 sm:px-10 md:px-14 lg:px-16 md:py-16 grid lg:grid-cols-2 gap-10 lg:gap-12 items-center">
    <div>
      <p class="eyebrow">
        <span class="w-1.5 h-1.5 rounded-full bg-accent dark:bg-accent-light" aria-hidden="true"></span>
        <span data-i18n="hero.eyebrow">{t['hero.eyebrow']}</span>
      </p>
      <h1
        class="hero-headline mt-6 text-[38px] sm:text-5xl lg:text-[64px] font-extrabold leading-[1.14] tracking-[-0.045em] text-ink dark:text-snow"
        data-i18n="hero.headline"
        data-i18n-html
        set:html={t['hero.headline']}
      />
      <p class="mt-5 max-w-md text-lg leading-relaxed text-ink-soft dark:text-snow-soft" data-i18n="hero.lead">
        {t['hero.lead']}
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#products" class="btn-primary" data-i18n="products.title">{t['products.title']}</a>
        <a href="#buy" class="btn-secondary" data-i18n="buy.title">{t['buy.title']}</a>
      </div>
    </div>

    {stage.length > 0 && (
      <div class="relative h-[300px] sm:h-[380px] lg:h-[460px] rounded-3xl dark:bg-paper-dim" aria-hidden="true">
        {stage.map(({ product, cls }) => (
          <img
            src={`/products/images/${product!.image}`}
            alt=""
            class:list={['absolute object-contain object-bottom mix-blend-darken', cls]}
            loading="eager"
          />
        ))}
        {featured && (
          <div
            class="absolute left-0 top-2 lg:top-4 w-[188px] sm:w-[210px] rounded-2xl bg-white/95 dark:bg-night-high/95 px-4 py-3.5 shadow-[0_12px_32px_rgba(17,18,22,0.12)] flex flex-col gap-0.5"
          >
            <span class="text-[12px] font-semibold text-ink-mute dark:text-snow-mute">{featured.partNumber}</span>
            <span class="product-name text-[15px] font-bold text-ink dark:text-snow" data-name-ko={featured.nameKo} data-name-en={featured.nameEn}>{featured.nameKo}</span>
            <span class="text-xl font-extrabold tracking-[-0.02em] text-ink dark:text-snow">{formatPrice(featured.price)}</span>
          </div>
        )}
      </div>
    )}
  </div>
</section>
