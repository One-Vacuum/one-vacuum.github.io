---
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import { ui } from '../i18n/ui';

const t = ui.ko;
---

<header class="sticky top-0 z-50 bg-white/85 dark:bg-night/85 backdrop-blur-md border-b border-line/80 dark:border-night-line">
  <div class="container-custom">
    <div class="flex items-center justify-between gap-4 h-16 md:h-[72px]">
      <!-- Logo -->
      <a href="/" class="focus-ring flex items-center rounded-sm text-ink dark:text-snow">
        <Logo class="h-[13px] sm:h-[15px] md:h-[17px] w-auto" />
      </a>

      <!-- Navigation -->
      <nav class="hidden md:flex items-center gap-1 text-[15px] font-semibold" aria-label="Main">
        <a href="#products" class="nav-link" data-i18n="nav.products">{t['nav.products']}</a>
        <a href="#buy" class="nav-link" data-i18n="nav.buy">{t['nav.buy']}</a>
        <a href="#contact" class="nav-link" data-i18n="nav.contact">{t['nav.contact']}</a>
      </nav>

      <!-- Controls -->
      <div class="flex items-center gap-1.5">
        <LanguageSwitcher />

        <!-- Theme Toggle: icon follows the `dark` class, no JS swap needed -->
        <button id="theme-toggle" type="button" class="icon-btn" aria-label="Toggle theme">
          <svg class="w-[18px] h-[18px] dark:hidden" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4" />
          </svg>
          <svg class="w-[18px] h-[18px] hidden dark:block" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.5 14.5A8.5 8.5 0 019.5 3.5a8.5 8.5 0 1011 11z" />
          </svg>
        </button>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" type="button" class="icon-btn md:hidden" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <nav id="mobile-menu" class="hidden md:hidden pb-4" aria-label="Mobile">
      <div class="flex flex-col gap-1 text-base font-semibold">
        <a href="#products" class="nav-link py-3" data-i18n="nav.products">{t['nav.products']}</a>
        <a href="#buy" class="nav-link py-3" data-i18n="nav.buy">{t['nav.buy']}</a>
        <a href="#contact" class="nav-link py-3" data-i18n="nav.contact">{t['nav.contact']}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    const open = mobileMenu?.classList.toggle('hidden') === false;
    menuBtn.setAttribute('aria-expanded', String(open));
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
    });
  });

  // Theme toggle (default: light). The sun/moon icons switch via `dark:` classes.
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
  });
</script>
