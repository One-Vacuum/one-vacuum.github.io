---
import { ui } from '../i18n/ui';

interface Props {
  partNumber: string;
  nameKo: string;
  nameEn: string;
  image: string;
  price: string;
  rawPrice: number;
  category: string;
  descriptionKo?: string;
  descriptionEn?: string;
  bestSeller?: boolean;
  naverUrl?: string;
  coupangUrl?: string;
  /** True when `coupangUrl` is an exact product page; false when it is a
   *  generated Coupang search link. Drives the Coupang button's aria-label. */
  coupangIsExact?: boolean;
}

const { partNumber, nameKo, nameEn, image, price, rawPrice, category, descriptionKo, descriptionEn, bestSeller, naverUrl, coupangUrl, coupangIsExact } = Astro.props;

const t = ui.ko;
const coupangKey = coupangIsExact ? 'products.viewOnCoupangExact' : 'products.viewOnCoupang';
---

<article
  class="product-card group/card h-full flex flex-col"
  data-category={category}
  data-price={rawPrice}
  data-best-seller={bestSeller ? '1' : '0'}
  data-part-number={partNumber}
>
  <!-- Image well stays light in dark mode so the photo's white background
       disappears via mix-blend-darken. -->
  <div class="relative aspect-square overflow-hidden rounded-[20px] bg-paper-well dark:bg-paper-dim">
    <img
      src={image}
      alt={nameKo}
      data-alt-ko={nameKo}
      data-alt-en={nameEn}
      class="absolute inset-0 w-full h-full object-contain p-5 md:p-7 mix-blend-darken transition-transform duration-500 group-hover/card:scale-[1.04]"
      onerror="this.src='/images/placeholder-product.svg'"
      loading="lazy"
      decoding="async"
    />
    {bestSeller && (
      <span class="absolute left-3 top-3 rounded-full bg-white px-2.5 py-1 font-display text-[10px] font-bold tracking-[0.1em] text-accent [font-stretch:125%]" data-i18n="products.bestSeller">BEST</span>
    )}
  </div>

  <div class="pt-4 flex flex-col flex-1">
    <p class="text-[13px] text-ink-mute dark:text-snow-mute">{partNumber}</p>
    <h3 class="product-name mt-1 min-h-[2.6em] line-clamp-2 text-[15px] md:text-[17px] font-bold leading-snug tracking-[-0.02em] text-ink dark:text-snow" data-name-ko={nameKo} data-name-en={nameEn}>{nameKo}</h3>
    {(descriptionKo || descriptionEn) && (
      <p class="product-desc mt-1 text-sm text-ink-soft dark:text-snow-soft" data-desc-ko={descriptionKo || ''} data-desc-en={descriptionEn || ''}>{descriptionKo}</p>
    )}
    <p class="mt-2 text-lg md:text-xl font-extrabold tracking-[-0.02em] text-ink dark:text-snow">{price}</p>

    <!-- Store links. Coupang is always present (exact URL or generated search
         link); Naver only when the product has a listing. Buttons stack on very
         narrow cards (2-col mobile grid) and sit side by side once there's room.
         Neutral buttons; the brand is signalled by a small colour dot. -->
    <div class="mt-auto pt-4 flex flex-col min-[480px]:flex-row gap-2">
      {naverUrl && (
        <a href={naverUrl} target="_blank" rel="noopener noreferrer" aria-label={t['products.viewOnNaver']} data-i18n-aria-label="products.viewOnNaver" class="store-btn">
          <span class="w-1.5 h-1.5 rounded-full bg-naver" aria-hidden="true"></span>
          <span data-i18n="products.cardNaver">{t['products.cardNaver']}</span>
        </a>
      )}
      {coupangUrl && (
        <a href={coupangUrl} target="_blank" rel="noopener noreferrer" aria-label={t[coupangKey]} data-i18n-aria-label={coupangKey} class="store-btn">
          <span class="w-1.5 h-1.5 rounded-full bg-coupang" aria-hidden="true"></span>
          <span data-i18n="products.cardCoupang">{t['products.cardCoupang']}</span>
        </a>
      )}
    </div>
  </div>
</article>
