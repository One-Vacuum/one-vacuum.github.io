---
import { ui } from '../i18n/ui';
import InquiryForm from './InquiryForm.astro';

const t = ui.ko;
---

<section id="inquiry" class="section pt-0" aria-labelledby="inquiry-title">
  <div class="container-custom grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] gap-10 lg:gap-16 items-start">
    <div class="lg:pt-6">
      <h2 id="inquiry-title" class="section-title" data-i18n="inquiry.title">{t['inquiry.title']}</h2>
      <p class="section-sub max-w-sm" data-i18n="inquiry.lead">{t['inquiry.lead']}</p>
    </div>

    <!-- Inquiry form → email (src/lib/inquiry.ts) -->
    <InquiryForm id="inquiry-form" class="rounded-[28px] md:rounded-[32px] bg-paper dark:bg-night-raised p-6 sm:p-8 md:p-10" />
  </div>
</section>
